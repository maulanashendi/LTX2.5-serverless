{
  "tests": [
    {
      "name": "worker_health_check",
      "input": {
        "health_check": true
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA B200",
    "gpuCount": 1,
    "env": [
      {
        "key": "RUN_MODE",
        "value": "worker"
      },
      {
        "key": "RUNPOD_HUB_VALIDATION",
        "value": "true"
      },
      {
        "key": "LTX25_PRELOAD_VARIANT",
        "value": ""
      },
      {
        "key": "LTX25_PRELOAD_PROMPT_ENHANCER",
        "value": "false"
      },
      {
        "key": "LTX25_MODEL_DISCOVERY_CHECK",
        "value": "false"
      },
      {
        "key": "PERSIST_WORKSPACE",
        "value": "false"
      }
    ],
    "allowedCudaVersions": [
      "13.0",
      "12.8"
    ]
  }
}
