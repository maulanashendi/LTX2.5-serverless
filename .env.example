# LTX 2.5 serverless worker — environment reference.
#
# Copy to .env for local docker-compose, or paste the values you need into the
# Runpod endpoint template. Every name here is read by the code; defaults shown
# are the ones the code falls back to when the variable is unset.
#
# Values marked REQUIRED have no usable default in production.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------

# worker    = Runpod Serverless (the handler owns the process)
# local-api = handler with --rp_serve_api on :8000, for local testing
# pod       = ComfyUI + bundled frontend only, no handler
RUN_MODE=worker

# Keep this "true" even with NO network volume attached. With no volume,
# bootstrap_workspace takes its "no persistent mount detected" branch and still
# regenerates extra_model_paths.yaml against /comfyui. Setting it "false"
# returns *before* that write and leaves the file baked into the image, which
# points at a /runpod-volume that does not exist — ComfyUI then cannot resolve
# diffusion_models, text_encoders or latent_upscale_models.
PERSIST_WORKSPACE=true

# The bundled frontend is for pod mode; a serverless worker does not serve it.
LTX_FRONTEND_ENABLED=false

COMFY_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Model weights — served from Cloudflare R2
# ---------------------------------------------------------------------------
# Populate the bucket once with scripts/mirror-models-to-r2.sh, then point the
# worker at it. Weights are pulled onto container disk at every cold start, so
# no network volume is needed and the endpoint is not pinned to a data center.
#
# This URL is fetched with a plain unauthenticated GET, so it must be the
# bucket's PUBLIC hostname — an r2.dev subdomain or your own custom domain, NOT
# the S3 API endpoint (that one requires signing).
#
# Leave unset to fall back to Hugging Face, which is what this exists to avoid:
# a rate-limited or down HF means a cold start that cannot serve.
# REQUIRED
LTX25_REPO_URL=https://models.example.com/ltx-2.5

# Prompt enhancer. It lives in a different Hugging Face repo (Comfy-Org/gemma-4)
# than the LTX weights, so it needs its own URL. Mirror it alongside the rest.
LTX25_ENHANCER_URL=https://models.example.com/ltx-2.5/text_encoders/gemma4_e2b_it_bf16.safetensors

# Only profile currently supported.
LTX25_PRELOAD_VARIANT=distilled-int8
LTX25_PRELOAD_PROMPT_ENHANCER=true

# Parallel downloads. Roughly 50GB is pulled per cold start, all of it on billed
# GPU time, so this is worth tuning against what the bucket actually sustains.
LTX25_DOWNLOAD_CONCURRENCY=4

# auto | hf_hub | wget. "auto" only uses hf_hub for huggingface.co URLs, so an
# R2 mirror always goes through wget and needs no Hugging Face token.
LTX25_DOWNLOAD_BACKEND=auto

# Only needed when pulling from Hugging Face directly (gated repo). Leave empty
# when LTX25_REPO_URL points at your own public mirror.
HUGGINGFACE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Generated video output — Cloudflare R2
# ---------------------------------------------------------------------------
# Without a bucket the worker returns the video inline as base64, which the
# senai backend rejects outright (PROVIDER_INLINE_OUTPUT_REJECTED). Configure
# this for any endpoint that backend will consume.

# REQUIRED for url output
AWS_BUCKET_NAME=senai-renders

# R2 is S3-compatible but not AWS, so boto3 has to be pointed at it. boto3 reads
# this natively — no code change and no endpoint_url argument is involved.
# Format: https://<account-id>.r2.cloudflarestorage.com
# REQUIRED for url output
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com

# R2 has no real regions; it expects the literal "auto".
AWS_DEFAULT_REGION=auto

# R2 API token with Object Read & Write on the bucket above.
# REQUIRED for url output
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The worker returns a presigned GET valid for 7 days (604800s), which is R2's
# maximum — do not raise it in handler.py without checking R2's limit first.
#
# The senai backend also checks the URL host against the binding's
# allowed_output_hosts, so add your R2 hostname there or the artifact is dropped
# with PROVIDER_OUTPUT_HOST_REJECTED.

# Cap before S3/R2 upload becomes mandatory rather than inlining base64.
MAX_INLINE_VIDEO_MB=50

# ---------------------------------------------------------------------------
# ComfyUI
# ---------------------------------------------------------------------------

COMFY_HOST=127.0.0.1:8188

# How long the handler waits for ComfyUI to answer /system_stats before the
# first job renders. A cold start downloads ~50GB first, so keep this generous:
# too low and the first request fails while the worker is still healthy.
COMFY_READY_TIMEOUT=900

COMFY_INPUT_DIR=/comfyui/input
COMFY_OUTPUT_DIR=/comfyui/output

# Verifies the models are visible through the live ComfyUI API before serving.
LTX25_MODEL_DISCOVERY_CHECK=true
COMFY_MODEL_DISCOVERY_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Handler
# ---------------------------------------------------------------------------

# Local only. An external Redis is rejected at import time, by design: the cache
# is per-worker and dies with the worker, so pointing several workers at one
# shared Redis would be misleading rather than useful.
REDIS_URL=redis://127.0.0.1:6379

# Successful-response cache lifetime.
CACHE_TTL_SECONDS=604800

# Lets the flat input path accept "image" as an http(s) URL instead of base64.
# Off by default: it lets a request make the worker fetch an arbitrary URL.
# Data URLs and raw base64 always work and need no flag.
LTX_ALLOW_REMOTE_IMAGE=false

# ---------------------------------------------------------------------------
# Mirroring (scripts/mirror-models-to-r2.sh — your machine, not the worker)
# ---------------------------------------------------------------------------
# Lightricks/LTX-2.5 is gated. Confirm its licence permits mirroring into your
# own bucket before running the script.

R2_BUCKET=ltx-models
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# The script needs room for the largest single file (~21.5GB) and refuses to
# start otherwise. /tmp is usually too small.
MIRROR_WORK_DIR=/var/tmp

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Starts sshd in the container when set (pod debugging).
PUBLIC_KEY=
